# Clavis environment variables: names only, never real values.
#
# Local development: copy this file to `.env.local` (git-ignored) and fill in values.
# Production (Vercel): Project -> Settings -> Environment Variables. Mark MODEL_API_KEY
# as Sensitive.
#
# Only names starting with NEXT_PUBLIC_ reach the browser. Everything else is read on the
# server only, by the assistant route (src/app/api/assistant -> server/assistant.ts).
# Without a model key Clavis still works fully with Clavis Local, its built-in engine.

# --- Hosted assistant ----------------------------------------------------------------

# groq (default) | meta | openai-compatible
MODEL_PROVIDER=groq

# The provider's API key. Groq: console.groq.com -> API Keys -> Create API Key.
MODEL_API_KEY=

# Optional overrides (defaults per provider are in server/providers.ts).
# Groq default model: openai/gpt-oss-120b (openai/gpt-oss-20b is faster and cheaper).
# MODEL_ID=
# MODEL_EXPLAIN_ID=
# Models to try, in order, when the main one is rate-limited (Groq limits each model
# separately; same key). Groq default: openai/gpt-oss-20b. Set it empty for none.
# MODEL_FALLBACK_IDS=
# Required for openai-compatible, e.g. a local Ollama server: http://127.0.0.1:11434/v1
# MODEL_BASE_URL=

# --- Site ----------------------------------------------------------------------------

# The public address, used for link previews. Optional on Vercel: the production domain
# is used when this is unset. Locally it falls back to http://localhost:5199.
# NEXT_PUBLIC_SITE_URL=https://clavisstudio.vercel.app

# --- Accounts and cloud plans (Supabase) -----------------------------------------------
# Supabase -> Project Settings -> API Keys. Until these are set, sign-in shows "not
# configured" and plans stay in the browser. Run supabase/migrations/*.sql in the SQL Editor
# once; `npm run db:check` then proves each person sees only their own rows.

# Project URL and the publishable key (sb_publishable_...): safe to be public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The secret key (sb_secret_...): SERVER ONLY. Never prefix it with NEXT_PUBLIC_. In Vercel,
# mark it Secret. Used to count AI allowances, for the health check and by the scripts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Hackathon judges' demo account (public on purpose: shown in the site footer) ---------
# `npm run judges` creates the account and writes these two here; copy them into Vercel.
# `npm run judges -- reset` restores its sample plans.
# NEXT_PUBLIC_JUDGES_EMAIL=
# NEXT_PUBLIC_JUDGES_PASSWORD=
