{
  "name": "clavis",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Clavis — describe a home in plain language; it is laid out in metres, checked by a deterministic validator, and shown in synchronized 2D and 3D.",
  "scripts": {
    "dev": "next dev -p 5199",
    "build": "next build",
    "start": "next start -p 5199",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run tests/live --reporter=verbose",
    "e2e": "node tests/e2e/smoke.mjs",
    "db:check": "node scripts/db-check.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.178.0",
    "zod": "4.6.6",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.178.0",
    "@vitejs/plugin-react": "^4.6.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
